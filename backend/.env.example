# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only. Lets the API create users and store sign-up codes.
# Supabase > Project Settings > API Keys > service_role (secret). Never put it in the front end.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only for projects still using the legacy JWT secret
# (Project Settings > API > JWT Settings). Leave empty to use the public signing keys.
SUPABASE_JWT_SECRET=

# Audience claim in Supabase access tokens. The default is correct for most projects.
SUPABASE_JWT_AUDIENCE=authenticated

# Front-end origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Resend (email). Supabase sends auth emails itself, so paste the same key into
# Supabase > Authentication > Emails > SMTP Settings. The API does not read these yet;
# they are here for future backend-sent email (e.g. game invites).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Board Playable <noreply@boardplayable.site>
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
