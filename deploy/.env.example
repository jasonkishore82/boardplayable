# Copy this file to deploy/.env and fill it in. The real .env is never committed.

# The address players' browsers use to reach the API. Its DNS A record must point at this server.
API_DOMAIN=api.boardplayable.site

# Supabase project URL (Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key that lets the API create users and store sign-up codes
# (Project Settings > API Keys > service_role). Keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects still on the legacy JWT secret (Project Settings > JWT Keys). Usually empty.
SUPABASE_JWT_SECRET=

# Sends the sign-up code emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Board Playable <noreply@boardplayable.site>

# The website addresses allowed to call the API, comma separated, no trailing slash.
CORS_ORIGINS=https://boardplayable.site,https://www.boardplayable.site
